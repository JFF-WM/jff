// jff example configuration
//
// Copy this file to ~/.config/jff/config.kdl (or point $JFF_CONFIG at it) and edit.
// Every block is optional: anything you leave out uses the built-in default.
//
// jff reloads the file when you save it (or on the `reload-config` bind). Everything takes
// effect on reload except the settings listed here, which only work the way they say:
//   autostart, sh-autostart   run once, when jff starts. A reload does not run a changed list.
//   render-device             the GPU is chosen when jff starts.
//   restore-apps              turning it on in a running session starts saving the open apps,
//                             but they are only started again at the next jff start.
//   color-representation yuv  clients tell the compositor what they can use when they connect:
//                             programs already running keep what they were told, restart them.
// Check a file without
// starting jff with `jff check-config [FILE]`: it reports errors and warns about unknown
// top-level nodes, which are otherwise silently ignored. An unknown key INSIDE a known block
// is an error.
//
// Flags (`maximize-new-windows`, `focus-follows-mouse`, `warp-mouse-to-focus`, `no-client-decorations`, `numlock`, `include-cursor`,
// `copy-to-clipboard`, `enable` in `log`, `hdr`, ...) accept a bare name (`numlock`),
// `#true` / `#false`, `"true"` / `"false"`, `"yes"` / `"no"` or `"on"` / `"off"`.
// Colors are written as "#rgb", "#rgba", "#rrggbb" or "#rrggbbaa".
//
// Lines that start with // and show a default value are the built-in behavior: uncomment and
// change them to taste. Lines marked "off by default" do nothing until you turn them on.

// ---------------------------------------------------------------------------------------------
// Workspaces
// ---------------------------------------------------------------------------------------------

// Number of workspaces: 1 to 64, 9 by default.
// With `per-output`, every monitor has a workspace of its own instead of all monitors switching
// together.
workspaces { count 5; per-output }
//workspaces 5 { per-output } // number plus block also works
//workspaces 9                // just the number

// Workspace wall (off by default). While you drag a thumbnail in the overview, a square per
// workspace appears to drop it on. `workspace-wall` alone turns it on, `workspace-wall #false`
// or `off` inside the block turns it off.
workspace-wall {
    height 240      // px, 32 to 400, 96 by default
    thumbnails #true // draw the windows in the squares (on by default)
}

// ---------------------------------------------------------------------------------------------
// Windows
// ---------------------------------------------------------------------------------------------

// Maximize new windows when they open (on by default). A window-rule can override it.
maximize-new-windows #true

// Draw windows without client-side decorations (titlebars) where the app allows it.
no-client-decorations #true

// Focus follows the mouse (off by default): the window under the pointer gets the keyboard as
// soon as the pointer moves onto it, no click needed. The window is not raised. The keyboard
// stays where it is while the overview, the screenshot selection or the lock screen is up, while
// a panel or launcher (fuzzel, a bar's menu) has the keyboard, while a menu is open, and while a
// button is held (a drag).
focus-follows-mouse #true

// The mouse follows the focus (off by default): when a window gets the keyboard by something
// other than the pointer (Alt+Tab, the overview, a new window, a workspace switch, a taskbar),
// the pointer jumps to the center of that window, also when it is over it already. A click never
// moves the pointer, and neither does a pointer a game has locked or a window being dragged.
// Use it together with `focus-follows-mouse`: that one moves the keyboard to the pointer, this one
// moves the pointer to the keyboard, so the two never disagree after Alt+Tab.
warp-mouse-to-focus #true

// The GPU that draws everything (read at startup). By default it is the primary one, the GPU
// the machine booted on. Every other GPU is opened too and lights the monitors wired to it, with
// no setting needed: they are named and set up in `outputs` like any other monitor. A name
// that two GPUs share (`DP-1` is on every GPU) stays with the primary's, and the other monitor
// is called after its GPU, `card1-DP-1`. The primary draws their frames and the other GPU only
// shows them, so they are SDR only, the cursor is drawn in software and `adaptive-sync` and
// `content-type-hint` do nothing there. A GPU plugged in while jff runs is picked up too. Name
// the GPU you want as primary here, usually the strongest one.
// List them with `ls /dev/dri/card*`.
// render-device "/dev/dri/card1"

// Restore the apps of the last session (off by default). While on, jff remembers every open
// window (its app id, workspace and monitor) in $XDG_STATE_HOME/jff-wm/open-apps. At the next
// start, after `autostart` has run, each of those apps is started once and its windows are put
// back on the monitor and workspace they were on. Apps already in `autostart` are not started
// twice, apps with no .desktop file are skipped. The monitor and workspace saved here win over
// those of a window-rule. Turning it on in a running session starts saving, and the next start
// restores. While it is off, jff neither reads nor writes the list.
// restore-apps #true

// Tiling containers (off by default): groups of windows that tile among themselves. Needed by
// `open-in-container` in a window-rule, `container-rule`, and the container binds below.
// tiling-containers #true

// Remember how every container is arranged (off by default, needs `tiling-containers`). The
// splits, their ratios and which window stands where are kept, by the app ids of the windows,
// until jff ends. When windows with the same app ids are tiled into a new container together
// again, say you dragged one of three kitty windows to the edge, which takes the container
// apart, and then one to the edge again, which tiles all three, the container gets the
// arrangement it had instead of the default split. A `container-rule` `layout` wins over it.
// remember-container-layouts #true

// Hold this key and drag with the mouse to move/resize windows. Alt (the default), Super, Ctrl
// or Shift.
drag-modifier "Super"

// Hot corner: resting the pointer in a square at the top-left of a monitor opens the overview
// (and closes it again if it is open). Off unless this block (or `hot-corner N`) exists.
// `hot-corner 0` turns it off. While it is on, the pointer cannot change monitor through the
// corner's `size` px of edge. On a touchscreen, a finger that starts in the corner and swipes
// diagonally away from it opens the overview, a tap, or a drag along an edge, stays with the app.
hot-corner {
    size 10         // px, 0 to 64, 4 by default
    dwell-ms 50     // how long the pointer has to rest, 0 to 5000, 250 by default
    touch-size 48   // px, the corner a finger starts the swipe in, 0 to 200, 0 for no touch
                    // hot corner, 48 by default
    //monitor "DP-1" // only on this monitor, repeat the line for more. Default: every monitor
}
//hot-corner 6      // just the size

// Global hotkeys (xx-hotkey-v1, off by default): clients may bind their own hotkeys, which then
// work whatever has the keyboard. See also `forward-key` in binds. `jff msg hotkeys` lists what
// is bound, by whom, and whether it is held.
global-hotkeys #true

// Tearing (off by default). With it on, a fullscreen window that covers the monitor and asked
// for tearing (wp_tearing_control_v1, which games use) is shown with async page flips: lower
// input lag, visible tearing. Anything else, and any frame the hardware can't flip this way,
// is shown normally. Needs a Smithay with async page flips.
// allow-tearing #true

// The PC's power button: "suspend" (default), "power-off", "ignore", or "system" (leave it to
// logind). Needs systemd-inhibit and systemctl. `suspend` and `power-off` also work in binds.
// power-key "suspend"

// ---------------------------------------------------------------------------------------------
// Looks
// ---------------------------------------------------------------------------------------------

// Gap in px around maximized windows and between snapped ones: 0 to 512, 0 by default.
gaps 10

// Corner radius of windows in px: 0 to 256, 0 by default.
radius 12

// Corner radius of popups (menus, tooltips) in px, 0 to 256. Leave out to use `radius`.
// popup-radius 8

// Window border. Having the block at all turns borders on (2 px unless `width` says otherwise,
// `width 0` turns them off again).
border {
    width 3                    // px, 0 to 64
    color "#333567"            // unfocused windows
    focus-color "#333436"      // the focused window
    focus-color-2 "#ff3c36"    // a second color: the focused border blends between the two
    fade-ms 300                // time to change color, 0 to 5000, 150 by default
    animate "none"             // "none" (default), spin, sweep, smoke, neon, aurora
    period-ms 3000             // one turn of the animation, up to 600000, 3000 by default
}

// Window animations. `window-animations #false`, or `off` inside the block, turns them off.
window-animations {
    open "slide"    // "fade" (default), "zoom", "slide", "pop" or "none"
    open-ms 250     // 0 to 10000, 100 by default
    close-ms 80     // 0 to 10000, 80 by default
}
// A second window-animations block is ignored (only the first one counts), so this one is
// kept as a commented alternative:
// window-animations {
//     open-ms 100
//     close-ms 80
// }

// Background blur. Blur is OFF unless this block exists, writing it turns it on.
// It only shows on surfaces that are (partly) transparent, for example a terminal with
// opacity below 1.0. By default windows blur the WALLPAPER, so a wallpaper must be set (see
// autostart below).
//
// Which windows get blur (by app id, see `jff msg`, pick one style):
//   * `only-window "APP-ID"`    blur ONLY these apps, the whole window, no client request
//                               needed. Repeat the line for more apps.
//   * `all-windows` plus `ignore-window "APP-ID"`    blur every window except these apps.
//   * neither: only windows that ask for blur themselves (ext-background-effect) get it.
// `ignore-window` always wins, and also drops the blur behind that app's menus and popups.
// Which layer surfaces get blur (by namespace, see `layers` in `jff msg`):
//   * `only-layer "NAMESPACE"`  blur ONLY these layer surfaces, the whole surface, on any layer
//                               (also `bottom`). Case-sensitive. Repeat the line for more.
//   * `ignore-layer "NAMESPACE"` never blur this one (wins over `only-layer`).
// Corner radius of the blur behind layer surfaces (0 = square, the default), cut from the area
// that is really blurred (the client's blur region, else the surface):
//   * `layer-radius 16`                  every layer surface
//   * `layer-radius "JFShell-Bottom" 24` one namespace, wins over the general line
blur {
    only-window "kitty"
    //only-window "foot"
    //ignore-window "firefox-developer-edition"
    //only-layer "JFShell-Bottom"     // layer-surface namespaces that get blur, whole surface
    //only-layer "JFShell-Top"
    //ignore-layer "JFShell-Bottom"   // layer-surface namespaces that never get blur
    //ignore-layer "selection"
    //layer-radius 16                  // round the blur behind every layer surface
    //layer-radius "JFShell-Bottom" 24 // ...or just this namespace
    passes 5            // 1-31, each pass doubles the radius, 3 by default
    offset 3.0          // sample stretch, bigger = blurrier (and blockier), above 0, 3.0 by default
    //all-windows       // blur every window, not just those that ask for it
    //all-layers        // also blur panels/launchers on top/overlay layers
    //behind-windows    // also blur windows behind (default: wallpaper only)
    //off               // turn blur off without deleting the settings
}

// Overview (and switcher): how the selected thumbnail is outlined.
overview {
    selection-color "#333567" // "#rrggbbaa", a translucent blue by default
    selection-width 3         // px, 0 for no outline, 4 by default
    auto-open #true           // open the overview when the monitor in use has no windows, so you
                              // can type an app's name and start it. On by default, false: off
    animation-ms 320          // 0 to 2000, how long the overview takes to open and close, 0 = no
                              // animation, 320 by default
    blur                      // (off by default) for the frames and the search box
    border 2                  // px, 0 to 64, the border around the workspace squares (the frames of the
                              // stage, the squares of the workspace wall), 0 for none, 2 by default.
                              // The square under the pointer keeps the selection outline
    border-color "#ebedf980"  // "#rrggbbaa", the colour of that border. Left out: a translucent light grey
    backdrop-color "#101018"  // "#rrggbbaa", a colour over the whole monitor behind the stage's frames, over
                              // the wallpaper and its blur. Without alpha it is a plain static colour, with
                              // alpha the wallpaper shows through. Left out: none
    search-background-color "#1c1c23" // "#rrggbbaa", the fill of the search box and of the grid of apps
                              // under it. With alpha, what is behind shows through. Left out: dark
    search-font-color "#f2f2f7" // "#rrggbbaa", the colour of what is typed, the hint and the app names.
                              // With alpha it fades into the fill. Left out: light grey
    container-background-color "#0d0f1a66" // "#rrggbbaa", the fill of a tiling container's cell, over the
                              // blur when `blur` is on. "#00000000" shows the blur alone. The default is about
                              // this dark translucent colour
    container-border-width 2  // px, 0 to 64, the border of a tiling container's cell, 0 for none,
                              // 2 by default
    container-border-color "#bfc7e099" // "#rrggbbaa", the colour of that border
    container-font-color "#f2f2f7" // "#rrggbbaa", the colour of the name written on a tiling container's
                              // cell. Light grey by default
    container-radius 8        // px, 0 to 256, the corner radius of the cell: its border, fill and
                              // blur. Left out: half of the windows' `radius`
}

// Window switcher (the `switch-window` binds): a row of thumbnails, most recently used first.
switcher {
    thumbnail-height 640   // px, 32 to 4096. Leave out for the default size
    slide-ms 150           // 0 to 2000, 0 = jump instead of slide, 120 by default
    group-containers #true // a tiling container is one cell with all its windows in it, like in the
                           // overview, and one stop of the switcher that picks the window focused in
                           // it. On by default, #false: every window is a stop
}

// On-screen display: toasts for volume-like changes, errors, and so on.
osd {
    //off             // no toasts. Errors are still shown
    timeout-ms 5000   // 100 to 60000, 1800 by default
    font "Inter"      // a family name, "sans-serif" by default
}

// Kill the process of a window that does not close when it is asked to (off by default).
// "Asked to close" is the `close` bind, the overview's close button and middle click, a taskbar
// and `jff msg close`. If the window is still open after `seconds`, jff sends SIGKILL to the
// process of its client and shows a toast that says why (shown even with `osd { off }`).
// Careful: the whole process dies, with every other window it has and anything unsaved. A
// window that is slow to close because it asks "save changes?" counts as not closing.
// X11 windows are never killed, they all belong to one process (xwayland-satellite).
close-kill {
    enable
    seconds 5         // 1 to 3600, fractions are fine (2.5), 5 by default
}

// Screenshots.
screenshot {
    // Where screenshots are saved. Leave out to only copy to the clipboard.
    path "~/Pictures/"
    include-cursor #false     // off by default
    copy-to-clipboard #true   // on by default
}

// Write jff's log to a file (off by default).
log {
    enable
    path "/tmp/"          // a file, or a folder ending in "/". Optional, default /tmp/jff.log
    level "debug"         // "error", "warn", "info" (default), "debug" or "trace"
}

// ---------------------------------------------------------------------------------------------
// Input
// ---------------------------------------------------------------------------------------------

keyboard {
    // Keyboard layout (XKB). Examples: layout "us", layout "br" + variant "abnt2".
    xkb {
        layout "us"
        // variant "intl"
        // options "grp:alt_shift_toggle,caps:escape"
        // rules "evdev"
        // model "pc105"
    }
    repeat-delay 300    // ms before a held key repeats, 200 by default
    repeat-rate 40      // repeats per second, 25 by default
    //numlock #true     // Num Lock state at startup and after a keymap change, on by default
}

// Pointer devices (TTY session only, a nested jff has no libinput devices). `touchpad` applies to
// every touchpad, `mouse` to every other pointer device (mice, trackballs, pointing sticks),
// `device "NAME"` to the one device with that libinput name and wins over the other two. jff logs
// the name of every pointer device at info level when it appears (see `log` above).
// A setting you leave out keeps the device's own default, except `tap` on a touchpad, which is on.
// Settings apply when a device is plugged in and on reload: taking a line out puts it back.
// A setting a device does not support is skipped (a warning in the log).
// Every setting below is allowed in all three blocks.
input {
    touchpad {
        //tap #false                    // tap to click, on by default
        //tap-button-map "left-middle-right" // "left-right-middle" (libinput's default) or "left-middle-right": one, two, three fingers
        //drag #false                   // tap, then touch and move to drag
        natural-scroll                  // content follows the fingers
        accel-speed 0.2                 // -1 (slowest) to 1 (fastest), 0 by default
        //accel-profile "flat"          // "adaptive" (default) or "flat"
        //scroll-method "edge"          // "two-finger" (default), "edge", "on-button-down" or "none"
        //scroll-button "middle"        // button held for "on-button-down": left, right, middle, side, extra, forward, back or an evdev code
        //disable-while-typing #false   // ignore touches while typing, on by default
        //click-method "clickfinger"    // "button-areas" or "clickfinger": one, two, three fingers pressing
        //middle-emulation              // both buttons together are a middle click
        //left-handed                   // swap left and right buttons
        //disable-on-external-mouse     // send nothing while an external mouse is plugged in
        //off                           // send nothing at all
    }
    mouse {
        accel-profile "flat"
        //accel-speed 0
        //natural-scroll
        //scroll-method "on-button-down"
        //scroll-button "side"
        //middle-emulation
        //left-handed
    }
    // One device by name, over the blocks above. Repeat for more devices.
    // device "Logitech G502" {
    //     accel-speed -0.3
    // }

    // Touchscreens. Without a mapping a touchscreen covers the built-in panel (eDP, LVDS, DSI), else
    // the first monitor. `map-to-output` takes a monitor name (`jff msg outputs`), `touchscreen { }`
    // is for every touchscreen, `touchscreen "NAME" { }` for the one with that libinput name (jff
    // logs touchscreen names at info level) and wins. A monitor that is not connected is ignored.
    // A turned or scaled monitor needs nothing more. Three fingers on a touchscreen are jff's own:
    // sideways switches workspace, up opens the overview, down closes it.
    // touchscreen {
    //     map-to-output "eDP-1"
    // }
    // touchscreen "ELAN Touchscreen" {
    //     map-to-output "DP-2"
    // }
}

// The pointer image. `theme` and `size` fall back to $XCURSOR_THEME and $XCURSOR_SIZE, then to
// "default" and 24. Both are exported to the apps jff starts, and a change applies on reload to
// the cursor jff draws (an app that is already open keeps the size it read at its start).
cursor {
    theme "Adwaita"          // an XCursor theme folder name, see ~/.icons and /usr/share/icons
    size 32                  // px, 1 to 512
    //hide-when-typing       // hide on a key press, back when the pointer moves, off by default
    //hide-after-ms 3000     // hide after the pointer rests this long, 0 = never (default)
}

// ---------------------------------------------------------------------------------------------
// Programs started with the session (they see WAYLAND_DISPLAY, DISPLAY and the portal vars)
// ---------------------------------------------------------------------------------------------

// autostart "cmd" "arg" ...  runs a program directly.
// sh-autostart "cmd"         runs a line through the shell (pipes, &, variables).
// Examples (uncomment and adjust):
// sh-autostart "wbg /path/to/wallpaper.jpg"
// sh-autostart "waybar"
// autostart "gnome-keyring-daemon" "--start" "--components=secrets"

// ---------------------------------------------------------------------------------------------
// Monitors. Optional: without this block monitors use their preferred mode.
// Use the name your monitor has (for example from `wlr-randr`), one block per monitor.
// `jff-winit` is the name of the window jff opens when it runs nested inside another desktop.
// ---------------------------------------------------------------------------------------------

// outputs {
//     output "HDMI-A-1" {
//         //off                              // turn this monitor off
//         position 0 0                       // top-left corner in the shared desktop
//         mode "1920x1080@60"                // WIDTHxHEIGHT or WIDTHxHEIGHT@REFRESH
//         scale 1.5                          // draw the desktop 1.5 times larger, 0.25 to 10, 1 by default (fractional scale, clients that know wp_fractional_scale draw sharp)
//         transform "90"                     // turn the picture onto the panel: "normal" (default), "90", "180", "270", "flipped", "flipped-90", "flipped-180" or "flipped-270". Named as wl_output names them, 90 is a quarter turn counter-clockwise
//         adaptive-sync "fullscreen"         // "off", "fullscreen" (default) or "always" (quoted)
//         content-type-hint                  // tell the monitor what is on screen: a fullscreen window that says photo, video or game switches its picture mode
//         icc-profile "~/.local/share/icc/panel.icc" // the monitor's colors, see color-management
//         color-management #false            // this monitor is not color managed ("off" works too)
//     }
//     output "DP-1" {
//         position 1920 0                    // place it to the right of the first
//         mode "1920x1080@144"
//
//         // HDR (off by default): signal this monitor as HDR10 (PQ, BT.2020) when its EDID and
//         // the connector allow it. The settings below only apply to a monitor with `hdr`,
//         // `jff check-config` warns when they stand alone. While jff runs, `jff msg hdr
//         // on|off|toggle [MONITOR]`, `jff msg sdr-white 203|+20|-20 [MONITOR]` and `jff msg hdr-set
//         // MONITOR peak|tone-map|contrast|black-level|saturation|white-balance|gamut-map VALUE`
//         // change them until the next `reload-config`, `jff msg hdr-reset MONITOR` puts a monitor's
//         // back to this file's without reloading the rest. Night light (wlr-gamma-control) works in HDR too.
//         hdr
//         sdr-white 203                      // cd/m2 SDR white is shown at, 10 to 1000, 203 by default
//         sdr-transfer "gamma22"             // how SDR windows are decoded: "srgb" (default) or "gamma22" (darker darks)
//         hdr-peak 1000                      // replaces the peak the EDID states, 100 to 10000
//         hdr-contrast 1.2                   // contrast around SDR white, 0.5 to 2.0, 1.0 by default
//         hdr-black-level 0.2                // cd/m2 added to the shadows (negative crushes them), -5.0 to 5.0, 0 by default
//         hdr-saturation 1.1                 // color intensity, 0.0 to 2.0, 1.0 by default, brightness is kept
//         hdr-white-balance 1.0 0.95 0.9     // gain of red, green and blue, 0.5 to 1.5 each, 1.0 1.0 1.0 by default
//         hdr-tone-map "bt2390"              // how the frame is rolled off under the peak: "knee" (default) or "bt2390"
//         hdr-content-metadata #true         // fit the roll-off to the content's own peak (on by default)
//         hdr-gamut-map "clip"               // colors outside the panel's gamut: "compress" (default, toward grey) or "clip" (each channel)
//         hdr-min-luminance 0.05             // cd/m2 of the panel's black, 0.0 to 1.0, replaces the EDID's, the shadows are raised off it
//     }
//     output "jff-winit" {
//         hdr                                // simulate HDR when nested (hdr-peak is 1000 by default here)
//     }
// }

// Color management (wp-color-management). On by default. With no block, surfaces a client
// tagged with another gamut or curve than the monitor's are converted to it.
// color-management {
//     off                        // do not offer wp-color-management, draw every surface as it always was
//     convert-srgb               // convert untagged (sRGB) surfaces too: stops them looking oversaturated on a wide-gamut panel, give the monitor an `icc-profile`
//     fullscreen-passthrough     // never convert a fullscreen window, so it can still be scanned out
// }

// Color representation (wp-color-representation). On by default. With `yuv`, video that says
// which YUV matrix and range it uses (BT.709 limited range, say) is drawn with exactly those,
// instead of whatever the graphics driver assumes (BT.601 limited). Such a surface is drawn
// by the renderer, so it does not get direct scanout. Turn it off to keep scanout for video:
// color-representation { yuv false }

// ---------------------------------------------------------------------------------------------
// Window rules. Any number of blocks.
//
// A window gets the FIRST rule whose `match` lines all hold, top to bottom, so put specific
// rules above general ones. Rules are checked when a window first shows something.
//
//   match app-id="..."     the app id, exactly
//   match title="..."      the title contains this text
//   match tag="..."        the tag of the window: the app's own (xdg-toplevel-tag) or yours (`tag` below)
//   match dialog=#true     a dialog (has a parent, or said so), #false: not a dialog
//   match restored=#true   put back by the app's session, #false: a new window
//   (several match lines, or several key=value pairs on one line, must all hold,
//    a rule with no match line fits every window)
//
//   open-on-output "NAME"  a monitor by name (as in the outputs block above)
//   open-on-output "pointer"   the monitor the pointer is on
//   open-workspace N       1 to 64
//   open-maximized #true   #false keeps the window floating
//   open-size W H          pixels, 1 to 16384, kept inside the monitor
//   open-position X Y      the window's top left, in pixels from the top left of its monitor
//                          (0 to 16384), kept inside the monitor. The window floats
//   open-centered          the middle of its monitor. The window floats. Not with `open-position`
//   floating               keep the window floating (no auto-maximize)
//   opacity N              0 to 1, how opaque the window is drawn. A rule with only an `opacity`
//                          does not use up the one rule a window gets
//   open-in-container "NAME"   join the container of that name on the window's workspace and
//                          monitor, or start one that fills the usable area. Needs
//                          `tiling-containers`. A dialog joins too: use `match dialog=#false` or
//                          a tag to keep dialogs out. Cannot be combined with `floating`
//   tag "NAME"             give the window a tag of yours, which `match tag` and every rule sees
//                          from then on, whatever its title changes to. A rule with only a `tag`
//                          does not use up the one rule a window gets
//   content-type "game"    what the window shows, whatever its client says: "game", "video" or
//                          "photo". A game that runs through X11 (Proton) cannot say it is one
//                          itself: with `game`, an output with `content-type-hint` tells its
//                          monitor so while the window covers it fullscreen (`video` and `photo`
//                          do the same for the monitor's cinema and photo modes). "none" ignores
//                          what the client says. Set when the window opens. A rule with only a
//                          `content-type` does not use up the one rule a window gets
//   always-on-top          the window stays above the ones that are not, even above a fullscreen
//                          one (a picture-in-picture player). Set when the window opens, the
//                          `always-on-top` command of `jff msg` changes it later. A rule with only an
//                          `always-on-top` does not use up the one rule a window gets
//   sticky                 the window is shown on every workspace of its monitor. Set when the
//                          window opens, the `sticky` command of `jff msg` changes it later. A
//                          window in a tiling container is on one workspace, so it is not sticky.
//                          A rule with only a `sticky` does not use up the one rule a window gets
//
// Change DP-1 and HDMI-A-2 below to your monitor names.
// ---------------------------------------------------------------------------------------------

// A rule with only a tag: names the window, and the rules below can match it.
// window-rule {
//     match app-id="firefox-developer-edition" title="Picture-in-Picture"
//     tag "picture-in-picture"
// }

// A game that cannot say it is one (X11 / Proton): the monitor is told while it is fullscreen.
// Needs `content-type-hint` on the output. `toggle-stats` shows what jff took the window for.
// `video` and `photo` work the same way, for a player that does not say what it shows.
// window-rule {
//     match app-id="steam_app_1245620"
//     content-type "game"
// }

// A tagged browser window: first monitor, workspace 1, maximized.
window-rule {
    match app-id="firefox-developer-edition"
    match tag="browser"

    open-on-output "DP-1"
    open-workspace 1
    open-maximized #true
}

// Picture-in-picture: a small floating window on the second monitor.
window-rule {
    match app-id="firefox-developer-edition"
    match tag="picture-in-picture"

    floating
    open-size 480 270
    open-on-output "HDMI-A-2"
}

// Dialogs: on the monitor the pointer is on, 900x700, centred as usual.
window-rule {
    match dialog=#true

    open-on-output "pointer"
    open-size 900 700
}

// A window that should stay small and floating instead of opening maximized.
window-rule {
    match app-id="org.pulseaudio.pavucontrol"

    open-maximized #false
    open-size 800 500
}

// A calculator: small, floating, in the middle of the monitor the pointer is on, a bit see-through.
window-rule {
    match app-id="org.gnome.Calculator"

    open-on-output "pointer"
    open-size 360 520
    open-centered
    opacity 0.95
}

// A floating notes window pinned near the top right of the first monitor.
// window-rule {
//     match app-id="scratch-notes"
//
//     open-on-output "DP-1"
//     open-size 500 400
//     open-position 1380 40
// }

// Match by title, and only for plain windows: workspace 3.
window-rule {
    match title="Meet - " dialog=#false

    open-workspace 3
}

// A VR runtime: open on whichever monitor the pointer is on.
window-rule {
    match app-id="monado-service"

    open-on-output "pointer"
}

// Terminals open in a container named "Terminals" (needs `tiling-containers`).
// window-rule {
//     match app-id="foot" dialog=#false
//
//     open-in-container "Terminals"
// }

// Keep last. Windows an app's session put back go to workspace 1. They keep the monitor,
// size and mode that were saved, so only open-workspace applies to them.
window-rule {
    match restored=#true

    open-workspace 1
}

// opacity for kitty terminal
window-rule { match app-id="kitty"; opacity 0.9; }

// Per-window SDR on a monitor with `hdr`. `sdr-white` (10 to 1000 cd/m2) is the window's own
// SDR white instead of the monitor's: a video player brighter than the desktop, a game dimmer.
// An HDR window moves along (its reference white, 203 cd/m2, is shown at that level and the
// light above it follows). `sdr` reads the window as plain sRGB whatever its client tagged it
// with. Both are set when the window opens, and a rule with only these does not use up the one
// rule a window gets for its placement.
// window-rule { match app-id="mpv", sdr-white 350, }
// window-rule { match app-id="steam_app_1091500", sdr, sdr-white 160, }

// Keep a window above the others, e.g. a picture-in-picture player.
// window-rule { match title="Picture-in-Picture", always-on-top, sticky, }

// ---------------------------------------------------------------------------------------------
// Container rules (need `tiling-containers`). Any number of blocks.
//
// A container rule does not create a container, it names the one you create, from the first
// window that fits. The `match` lines all have to hold (app-id, title or tag, not dialog or
// restored), the first rule that fits a window applies.
//   name "NAME"     the container's name, for `focus-container` and `open-in-container`
//   layout "NAME"   apply the saved container layout NAME (see `save-container-layout`) every time
//                   a window that fits the rule joins a container, so tagged windows find their
//                   slot as they open
// `jff check-config` warns about a rule with neither.
// ---------------------------------------------------------------------------------------------

// container-rule {
//     match app-id="foot"
//     name "Terminals"
// }
// container-rule {
//     match tag="dev"
//     name "Dev"
//     layout "Dev"
// }

// ---------------------------------------------------------------------------------------------
// Container templates (need `tiling-containers`). Any number of blocks.
//
// A named group of apps that start together in one container. The bind `spawn-container "NAME"`
// starts every `run` and tiles their windows in a container called NAME, on the workspace and
// monitor the bind was pressed on.
//   run "prog" "arg" ...   a program to start, without a shell
//   app-id="ID"            on a `run`: the app id its window opens with. Default: the file name of
//                          the program. Needed when they differ (a Flatpak, a wrapper script).
//
// The arrangement is remembered: it is saved as the container layout NAME (see `jff msg layout-list`)
// and saved again whenever you move a divider or put a window elsewhere, and the next
// `spawn-container` lays the windows out that way. A `container-rule` `layout` wins over it.
//
// The name is the container's identity. While a container with that name exists, on any
// workspace or monitor, `spawn-container` shows it and focuses it and starts nothing, so it
// works like a scratchpad for the whole group. When its last window closes the container is
// gone and the next press starts the apps again.
//
// With `restore-apps`: an app the restore already put back is taken into the container instead of
// being started a second time, and one the restore is starting right now is waited for.
// ---------------------------------------------------------------------------------------------

// container-template "dev" {
//     run "kitty"
//     run "firefox" app-id="firefox"
// }

// ---------------------------------------------------------------------------------------------
// Key bindings: "Mod+Mod+Key" { action, }
//
// Modifiers: Ctrl, Alt, Shift, Super (also Logo, Mod4). The key is an XKB keysym name (Return,
// Tab, 1, F5, Print...), or MouseBack / MouseForward for the side buttons of a mouse.
// Workspace numbers count from 1. The built-in binds (Alt+Return terminal, Alt+M maximize,
// Alt+F fullscreen, Alt+Q close, Alt+O overview, Alt+Tab switch-window, Alt+1..9 workspaces...)
// are only used when there is no config file at all. Once you have one, only the binds in it
// exist, so list everything you want to keep.
//
// Actions:
//   terminal                      open $JFF_TERMINAL, $TERMINAL, or alacritty
//   spawn "prog" "arg" ...        run a program directly
//   spawn-sh "line"               run a line through the shell
//   maximize / fullscreen         toggle on the focused window
//   snap-left / snap-right / snap-top / snap-bottom
//   close                         ask the focused window to close
//   overview                      every window of the monitor as a thumbnail
//   switch-window / switch-window-back   the window switcher (press again to move on, letting go of the modifier picks)
//   workspace N / workspace-next / workspace-prev
//   move-to-workspace N           send the focused window there
//   reload-config / quit
//   screenshot-area / screenshot-fullscreen / screenshot-window
//   toggle-shortcuts-inhibit      let the focused window's keyboard-shortcuts inhibitor go, or come back
//   toggle-stats                  show or hide "statistics for nerds" for the focused window: client / shown /
//                                 display FPS, frame sync (vsync, VRR, tearing), HDR, direct scanout and why not.
//                                 While shown the window is composited (the overlay is drawn over it), so direct
//                                 scanout and tearing are off, and the overlay says so. `jff msg stats` reads the
//                                 same numbers without drawing anything.
//   forward-key "APP-ID"          hand the key to that app's window without focusing it, for its own global hotkeys
//   Needing `tiling-containers`:
//   spawn-container "NAME"        start the `container-template` NAME in a container of that name, or, when that
//                                 container exists (on any workspace), show and focus it instead
//   focus-container "NAME"        focus the first container with that name on this workspace
//   container-next / container-prev   move the focus through the focused window's container
//   container-drag                pick up the focused window of a container with the pointer (click to drop, right click cancels)
//   container-eject               take the focused window out of its container and float it
//   save-container-layout "NAME"  save the shape of the focused window's container
//   apply-container-layout "NAME" put the container in that shape again
// ---------------------------------------------------------------------------------------------

binds {
    // Programs
    Alt+Return { terminal; }
    // Alt+D { spawn "fuzzel", }              // app launcher, needs fuzzel installed
    // Super+L { spawn-sh "swaylock", }       // lock screen, needs swaylock installed

    // global hotkeys for OBS Studio
    Ctrl+Shift+g { forward-key "com.obsproject.Studio"; }
    Ctrl+Alt+g { forward-key "com.obsproject.Studio"; }

    // Windows
    Alt+M { maximize; }
    Super+F { fullscreen; }
    Alt+Q { close; }
    Alt+O { overview; }
    Alt+Tab { switch-window; }
    Alt+Shift+Tab { switch-window-back; }
    // MouseBack { overview, }                // mouse side button
    // Alt+Left { snap-left, }
    // Alt+Right { snap-right, }
    // Alt+Up { snap-top, }
    // Alt+Down { snap-bottom, }
    // Super+Escape { toggle-shortcuts-inhibit, }
    // Super+Shift+S { toggle-stats, }

    // Tiling containers (need `tiling-containers`)
    // Super+T { focus-container "Terminals", }
    // Super+J { container-next, }
    // Super+K { container-prev, }
    // Super+D { container-drag, }
    // Super+E { container-eject, }
    // Super+S { save-container-layout "Dev", }
    // Super+A { apply-container-layout "Dev", }
    // Super+B { spawn-container "dev"; }     // see container-template above

    // Session
    Alt+Shift+R { reload-config; }
    Ctrl+Alt+BackSpace { quit; }

    // Screenshots
    Print { screenshot-area; }
    Ctrl+Print { screenshot-fullscreen; }
    Alt+Print { screenshot-window; }

    // Workspaces
    Alt+1 { workspace 1; }
    Alt+2 { workspace 2; }
    Alt+3 { workspace 3; }
    Alt+4 { workspace 4; }
    Alt+5 { workspace 5; }
    Alt+6 { workspace 6; }
    Alt+7 { workspace 7; }
    Alt+8 { workspace 8; }
    Alt+9 { workspace 9; }
    Ctrl+Alt+Right { workspace-next; }
    Ctrl+Alt+Left { workspace-prev; }
    Alt+Shift+1 { move-to-workspace 1; }
    Alt+Shift+2 { move-to-workspace 2; }
    Alt+Shift+3 { move-to-workspace 3; }
    Alt+Shift+4 { move-to-workspace 4; }
    Alt+Shift+5 { move-to-workspace 5; }
    Alt+Shift+6 { move-to-workspace 6; }
    Alt+Shift+7 { move-to-workspace 7; }
    Alt+Shift+8 { move-to-workspace 8; }
    Alt+Shift+9 { move-to-workspace 9; }

    // output switching
    Super+Right       { focus-monitor "right"; }
    Super+Left        { focus-monitor "left"; }
    Super+Shift+Right { move-to-monitor "right"; }
    Super+Ctrl+Right  { move-workspace-to-monitor "right"; }
    Super+Shift+Left { move-to-monitor "left"; }
    Super+Ctrl+Left  { move-workspace-to-monitor "left"; }

    // minimize/unminimize and scratchpad
    Super+M       { minimize; }
    Super+Shift+M { unminimize; }
    Super+Minus       { scratchpad; }
    Super+Shift+Minus { move-to-scratchpad; }
}
