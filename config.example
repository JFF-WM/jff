// jff example configuration
//
// Copy this file to ~/.config/jff/config.kdl (or point $JFF_CONFIG at it) and edit.
// Every block is optional: anything you leave out uses the built-in default.

// Number of workspaces.
workspaces { count 5; per-output }
//workspaces 5 { per-output } // number plus block also works

// Workspace wall.
workspace-wall { height 120 }

// Maximize new windows when they open.
maximize-new-windows #true

// Draw windows without client-side decorations (titlebars) where the app allows it.
no-client-decorations #true

// Tearing. Off by default. With it on, a fullscreen window that covers the monitor and asked
// for tearing (wp_tearing_control_v1, which games use) is shown with async page flips: lower
// input lag, visible tearing. Anything else, and any frame the hardware can't flip this way,
// is shown normally. Needs a Smithay with async page flips.
// allow-tearing #true

// Hold this key and drag with the mouse to move/resize windows.
drag-modifier "Super"

// enable global hotkeys
global-hotkeys #true

screenshot {
    // Where screenshots are saved. Leave out to only copy to the clipboard.
    path "~/Pictures/"
    include-cursor #false
    copy-to-clipboard #true
}

osd {
    // off
    timeout-ms 5000
    font "Inter"
}

window-animations {
    open "slide" // zoom, slide, pop, none. Zoom, slide
    open-ms 250
    close-ms 80
}

// Overview and switcher: how the selected thumbnail is outlined.
overview {
    selection-color "#333567"
    selection-width 3
}

// A second window-animations block is ignored (only the first one counts), so this one is
// kept as a commented alternative:
// window-animations {
//     open-ms 100
//     close-ms 80
// }

hot-corner {
    size 10
    dwell-ms 50
}

switcher {
    thumbnail-height 640   // px, 32 to 4096
    slide-ms 150           // 0 to 2000, 0 = jump instead of slide
}

border {
    width 3
    color "#333567"
    focus-color "#333436"
    focus-color-2 "#ff3c36"
    fade-ms 300
    animate "none" // spin, sweep, none
    period-ms 3000
}

gaps 10
radius 12

// Background blur. Blur is OFF unless this block exists, writing it turns it on.
// It only shows on surfaces that are (partly) transparent, for example a terminal with
// opacity below 1.0. By default windows blur the WALLPAPER, so a wallpaper must be set (see
// autostart below).
//
// Which windows get blur (by app id, see `jff msg`, pick one style):
//   * `only-window "APP-ID"`    blur ONLY these apps, the whole window, no client request
//                               needed. Repeat the line for more apps.
//   * `all-windows` plus `ignore-window "APP-ID"`    blur every window except these apps.
//   * neither: only windows that ask for blur themselves (ext-background-effect) get it.
// `ignore-window` always wins, and also drops the blur behind that app's menus and popups.
blur {
    only-window "kitty"
    //only-window "foot"
    //ignore-window "firefox-developer-edition"
    //ignore-layer "jfshell-Bottom"   // layer-surface namespaces that never get blur
    //ignore-layer "selection"
    passes 5            // 1-31, each pass doubles the radius
    offset 3.0          // sample stretch, bigger = blurrier (and blockier)
    //all-windows       // blur every window, not just those that ask for it
    //all-layers        // also blur panels/launchers on top/overlay layers
    //behind-windows    // also blur windows behind (default: wallpaper only)
    //off               // turn blur off without deleting the settings
}

// Programs started with the session.
// autostart "cmd" "arg" ...  runs a program directly.
// sh-autostart "cmd"         runs a line through the shell (pipes, &, variables).
// Examples (uncomment and adjust):
// sh-autostart "wbg /path/to/wallpaper.jpg"
// sh-autostart "waybar"
// autostart "gnome-keyring-daemon" "--start" "--components=secrets"

binds {
    // Programs
    Alt+Return { terminal; }
    // Alt+D { spawn "fuzzel", }              // app launcher, needs fuzzel installed
    // Super+L { spawn-sh "swaylock", }       // lock screen, needs swaylock installed

    // global hotkeys for OBS Studio
    Ctrl+Shift+g { forward-key "com.obsproject.Studio"; }
    Ctrl+Alt+g { forward-key "com.obsproject.Studio"; }

    // Windows
    Alt+M { maximize; }
    Super+F { fullscreen; }
    Alt+Q { close; }
    Alt+O { overview; }
    // MouseBack { overview, }                // mouse side button

    // Session
    Alt+Shift+R { reload-config; }
    Ctrl+Alt+BackSpace { quit; }

    // Screenshots
    Print { screenshot-area; }
    Ctrl+Print { screenshot-fullscreen; }
    Alt+Print { screenshot-window; }

    // Workspaces
    Alt+1 { workspace 1; }
    Alt+2 { workspace 2; }
    Alt+3 { workspace 3; }
    Alt+4 { workspace 4; }
    Alt+5 { workspace 5; }
    Alt+6 { workspace 6; }
    Alt+7 { workspace 7; }
    Alt+8 { workspace 8; }
    Alt+9 { workspace 9; }
    Ctrl+Alt+Right { workspace-next; }
    Ctrl+Alt+Left { workspace-prev; }
    Alt+Shift+1 { move-to-workspace 1; }
    Alt+Shift+2 { move-to-workspace 2; }
    Alt+Shift+3 { move-to-workspace 3; }
    Alt+Shift+4 { move-to-workspace 4; }
    Alt+Shift+5 { move-to-workspace 5; }
    Alt+Shift+6 { move-to-workspace 6; }
    Alt+Shift+7 { move-to-workspace 7; }
    Alt+Shift+8 { move-to-workspace 8; }
    Alt+Shift+9 { move-to-workspace 9; }
}

// Monitors. Optional: without this block monitors use their preferred mode.
// Use the name your monitor has (for example from `wlr-randr`), one block per monitor.
// outputs {
//     output "HDMI-A-1" {
//         position 0 0                       // top-left corner in the shared desktop
//         mode "1920x1080@60"                // WIDTHxHEIGHT@REFRESH
//         adaptive-sync "fullscreen"         // "off", "fullscreen" or "always" (quoted)
//         content-type-hint
//         // icc-profile "/path/to/profile.icm"
//     }
//     output "DP-1" {
//         position 1920 0                    // place it to the right of the first
//         mode "1920x1080@144"
//     }
// }

// Window rules. Any number of blocks.
//
// A window gets the FIRST rule whose `match` lines all hold, top to bottom, so put specific
// rules above general ones. Rules are checked when a window first shows something.
//
//   match app-id="..."     the app id, exactly
//   match title="..."      the title contains this text
//   match tag="..."        the tag the app set (xdg-toplevel-tag), exactly
//   match dialog=#true     a dialog (has a parent, or said so), #false: not a dialog
//   match restored=#true   put back by the app's session, #false: a new window
//   (several match lines, or several key=value pairs on one line, must all hold,
//    a rule with no match line fits every window)
//
//   open-on-output "NAME"  a monitor by name (as in the outputs block above)
//   open-on-output "pointer"   the monitor the pointer is on
//   open-workspace N       1 to 64
//   open-maximized #true   #false keeps the window floating
//   open-size W H          pixels, kept inside the monitor
//   floating               keep the window floating (no auto-maximize)
//
// Change DP-1 and HDMI-A-2 below to your monitor names.

// A tagged browser window: first monitor, workspace 1, maximized.
window-rule {
    match app-id="firefox-developer-edition"
    match tag="browser"

    open-on-output "DP-1"
    open-workspace 1
    open-maximized #true
}

// Picture-in-picture: a small floating window on the second monitor.
window-rule {
    match app-id="firefox-developer-edition"
    match tag="picture-in-picture"

    floating
    open-size 480 270
    open-on-output "HDMI-A-2"
}

// Dialogs: on the monitor the pointer is on, 900x700, centred as usual.
window-rule {
    match dialog=#true

    open-on-output "pointer"
    open-size 900 700
}

// A window that should stay small and floating instead of opening maximized.
window-rule {
    match app-id="org.pulseaudio.pavucontrol"

    open-maximized #false
    open-size 800 500
}

// Match by title, and only for plain windows: workspace 3.
window-rule {
    match title="Meet - " dialog=#false

    open-workspace 3
}

// A VR runtime: open on whichever monitor the pointer is on.
window-rule {
    match app-id="monado-service"

    open-on-output "pointer"
}

// Keep last. Windows an app's session put back go to workspace 1. They keep the monitor,
// size and mode that were saved, so only open-workspace applies to them.
window-rule {
    match restored=#true

    open-workspace 1
}

// Color representation (wp-color-representation). Off by default. With `yuv`, video that says
// which YUV matrix and range it uses (BT.709 limited range, say) is drawn with exactly those,
// instead of whatever the graphics driver assumes (BT.601 limited). Such a surface is drawn
// by the renderer, so it does not get direct scanout.
// color-representation { yuv }

keyboard {
    // Keyboard layout (XKB). Examples: layout "us", layout "br" + variant "abnt2".
    xkb {
        layout "us"
        // variant "intl"
        // options "grp:alt_shift_toggle,caps:escape"
    }
    repeat-delay 300    // ms before a held key repeats
    repeat-rate 40      // repeats per second
}

// add log file
log {
    enable
    path "/tmp/"   // optional, default /tmp/
    level "debug"         // optional, default "info"
}
