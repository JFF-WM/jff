<?xml version="1.0" encoding="UTF-8"?>
<!-- org_kde_kwin_appmenu: the wire interface of KDE's appmenu protocol (KWayland / KWin),
     which Qt and some browsers use to tell the compositor where the DBus menu of a window
     lives. Request order and argument types must match what clients were built with. -->
<protocol name="appmenu">
  <interface name="org_kde_kwin_appmenu_manager" version="1">
    <description summary="appmenu manager">
      The manager creates an appmenu object for a surface.
    </description>

    <request name="create">
      <description summary="create an appmenu object for a surface"/>
      <arg name="id" type="new_id" interface="org_kde_kwin_appmenu"/>
      <arg name="surface" type="object" interface="wl_surface"/>
    </request>

    <request name="release" type="destructor">
      <description summary="release the manager"/>
    </request>
  </interface>

  <interface name="org_kde_kwin_appmenu" version="1">
    <description summary="appmenu of one surface">
      Carries the DBus address of the menu of the surface it was created for.
    </description>

    <request name="set_address">
      <description summary="set the DBus address of the menu"/>
      <arg name="service_name" type="string"/>
      <arg name="object_path" type="string"/>
    </request>

    <request name="release" type="destructor">
      <description summary="release the appmenu object"/>
    </request>
  </interface>
</protocol>
